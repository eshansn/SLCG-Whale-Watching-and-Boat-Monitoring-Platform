# Copy this file to .env and replace the example password before starting Compose.
# SQL Server requires at least 8 characters and three of four character classes.
MSSQL_SA_PASSWORD=Replace_With_A_Strong_Password_123!
API_PORT=8080
# For a separate public frontend/API origin, configure exact origins as indexed ASP.NET settings:
# Cors__AllowedOrigins__0=https://your-frontend.example.com
# Keep VITE_API_BASE_URL empty when Cloudflare exposes Vite and its /api proxy on one hostname.
# Set it to the public HTTPS API origin only when frontend and API use separate hostnames.
VITE_API_BASE_URL=
# Cloudflare Tunnel normally connects locally, so loopback is trusted by default. Add only the
# actual private proxy address when cloudflared runs on another host; never use a public wildcard.
# ReverseProxy__KnownProxies__2=10.0.0.10
# Server-side only. Never use this value in a VITE_ variable or frontend file.
TrackMyCar__ApiKey=
# Disable polling until real boats have their authorized tracker assignments.
TrackMyCar__Enabled=true
# Explicit opt-in only; leave false for real-user testing.
DevelopmentMockData__Enabled=false
# At least 32 random bytes. Never commit the real value.
JWT_SIGNING_KEY=Replace_With_At_Least_32_Random_Bytes
# Optional initial administrator. Omit after the account is provisioned.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=Replace_With_A_Strong_Admin_Password_123!
INITIAL_OPS_EMAIL=ops@example.com
INITIAL_OPS_PASSWORD=Replace_With_A_Strong_OPS_Password_123!
INITIAL_SHORE_EMAIL=shore@example.com
INITIAL_SHORE_PASSWORD=Replace_With_A_Strong_Shore_Password_123!
INITIAL_WILDLIFE_EMAIL=wildlife@example.com
INITIAL_WILDLIFE_PASSWORD=Replace_With_A_Strong_Wildlife_Password_123!
INITIAL_SHORE_WILDLIFE_EMAIL=shorewildlife@wwms.test
INITIAL_SHORE_WILDLIFE_PASSWORD=Replace_With_A_Strong_Shore_Wildlife_Password_123!
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=Replace_With_A_Strong_Owner_Password_123!
INITIAL_CREW_EMAIL=crew@example.com
INITIAL_CREW_PASSWORD=Replace_With_A_Strong_Crew_Password_123!
INITIAL_PASSENGER_EMAIL=passenger@example.com
INITIAL_PASSENGER_PASSWORD=Replace_With_A_Strong_Passenger_Password_123!
