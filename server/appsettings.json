{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5174",
      "http://localhost:52100",
      "http://127.0.0.1:52100"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient.TrackMyCarApiClient": "None"
    }
  },
  "TrackMyCar": {
    "BaseUrl": "https://gps.trackmycar.lk/api/api.php",
    "Enabled": true,
    "PollIntervalSeconds": 10,
    "RequestTimeoutSeconds": 15,
    "StaleAfterSeconds": 60,
    "OfflineAfterSeconds": 300,
    "RouteMinimumStopMinutes": 2,
    "StopSpeedThresholdKnots": 0.5,
    "StopRadiusMeters": 30
  },
  "Jwt": {
    "Issuer": "WhaleWatching.Api",
    "Audience": "WhaleWatching.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
